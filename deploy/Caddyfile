# The WetOwl box (netcup, 89.58.49.140). No domain, so the hostname is nip.io — Let's Encrypt
# issues for it, which is what gives the phone real TLS instead of a cleartext login. The
# provider's own name for the box resolves too, but megasrv.de is shared by every netcup
# customer and Let's Encrypt refuses it for having issued too many certificates already.
89-58-49-140.nip.io {
	encode zstd gzip

	# SSE must not be buffered or the client never sees track_ready.
	handle /events {
		reverse_proxy api:8770 {
			flush_interval -1
		}
	}

	# The API surface, listed explicitly so a UI route can never shadow an endpoint.
	# Both the bare collection path and everything under it: `path /queues/*` does NOT
	# match `/queues`, and that mismatch silently served the app shell to the client,
	# which then tried to parse a web page as JSON.
	@api path /accounts /accounts/* /admin /admin/* /api-docs /art /art/* /auth /auth/* /downloads /downloads/* /favourites /favourites/* /feed /feed/* /follows /follows/* /history /history/* /icon /icon.json /internal /internal/* /jams /jams/* /library /library/* /linked /linked/* /listens /linked /linked/* /listens/* /manifest.json /me /me/* /openapi.json /playback-log /playlists /playlists/* /queues /queues/* /search /search/* /social /social/* /sources /sources/* /spotify /spotify/* /stations /stations/* /stats /stats/* /status /status/* /sync /sync/* /tracks /tracks/* /uploads /uploads/* /users /users/*
	handle @api {
		reverse_proxy api:8770
	}

	# The installable builds and their manifests, served out of /dl — a directory of
	# their own, mounted separately, that no publish step ever deletes.
	#
	# The Android build, so a phone with no cable can install it. Content-Type matters:
	# served as anything else, Android downloads a file it then refuses to open.
	handle /muse.apk {
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=muse.apk"
		root * /dl
		file_server
	}

	# The iPhone build, served the same way. An ipa is handed to SideStore rather than
	# opened, so the content type only has to be something a browser will not try to
	# render — and the download has to keep its name, because that name is what
	# SideStore shows while it installs.
	handle /wetowl.ipa {
		header Content-Type application/octet-stream
		header Content-Disposition "attachment; filename=wetowl.ipa"
		root * /dl
		file_server
	}

	# What SideStore and AltStore read to find out WetOwl exists and which build is
	# current. Added once on the phone; every publish after that is an update in their
	# list rather than a file somebody has to find again.
	handle /wetowl-source.json {
		header Content-Type application/json
		header Cache-Control "no-cache"
		header Access-Control-Allow-Origin *
		root * /dl
		file_server
	}

	handle /wetowl.ipa.json {
		header Content-Type application/json
		header Cache-Control "no-cache"
		root * /dl
		file_server
	}

	# What the app reads to find out whether the APK above is newer than the one it is
	# running. Its own handler, because the app-shell fallback below answers anything it
	# does not recognise with index.html — so asking for a manifest that was not there
	# got a page of HTML and a parse error rather than "no manifest".
	handle /muse.apk.json {
		header Content-Type application/json
		header Cache-Control "no-cache"
		root * /dl
		file_server
	}

	# Flutter web build. try_files so a deep link still lands on the app shell.
	#
	# Everything revalidates. Nothing here said anything about caching, so browsers
	# applied their own guess — and for an installed app that guess covers the page,
	# the loader *and* the service worker script, which is the one file that has to be
	# re-read for a new version to be noticed at all. The app kept serving itself out
	# of its own cache across restart after restart with no way to find out there was
	# anything newer.
	#
	# `no-cache` is not `no-store`: the files are still kept, they are just checked
	# before use. With the ETags below that is a 304 and no body, so the cost of being
	# always up to date is one small request per file.
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		# The .br files beside each asset, compressed properly at publish time rather
		# than in a hurry per request — and the only compression Safari understands
		# besides gzip, which is what the iPhone was getting.
		file_server {
			precompressed br zstd gzip
		}
	}
}
