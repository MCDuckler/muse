# Temporary home on the CTA box. No domain, so the hostname is nip.io — Let's Encrypt
# issues for it, which is what gives the phone real TLS instead of a cleartext login.
158-69-192-169.nip.io {
	encode zstd gzip

	# SSE must not be buffered or the client never sees track_ready.
	handle /events {
		reverse_proxy api:8770 {
			flush_interval -1
		}
	}

	# The API surface, listed explicitly so a UI route can never shadow an endpoint.
	# Both the bare collection path and everything under it: `path /queues/*` does NOT
	# match `/queues`, and that mismatch silently served the app shell to the client,
	# which then tried to parse a web page as JSON.
	@api path /accounts /accounts/* /admin /admin/* /api-docs /art /art/* /auth /auth/* /downloads /downloads/* /favourites /favourites/* /feed /feed/* /follows /follows/* /history /history/* /internal /internal/* /jams /jams/* /library /library/* /linked /linked/* /listens /linked /linked/* /listens/* /me /openapi.json /playlists /playlists/* /queues /queues/* /search /search/* /sources /sources/* /spotify /spotify/* /stats /stats/* /status /status/* /sync /sync/* /tracks /tracks/* /uploads /uploads/*
	handle @api {
		reverse_proxy api:8770
	}

	# The Android build, so a phone with no cable can install it. Content-Type matters:
	# served as anything else, Android downloads a file it then refuses to open.
	handle /muse.apk {
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=muse.apk"
		root * /srv
		file_server
	}

	# Flutter web build. try_files so a deep link still lands on the app shell.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
