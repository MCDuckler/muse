// The bake-off's Slint Desk: the glass booth of the Look board. Rust (src/main.rs)
// fills the properties once a frame from wo-deskcore and answers the callbacks.
import "../../../design/fonts/Inter-Regular.ttf";
import "../../../design/fonts/Inter-SemiBold.ttf";
import "../../../design/fonts/JetBrainsMono-Regular.ttf";
import "../../../design/fonts/JetBrainsMono-SemiBold.ttf";
import "../../../design/fonts/Archivo-CondensedSemiBold.ttf";
import "../../../design/fonts/Archivo-MarkBlack.ttf";
import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";

export struct PadData { n: string, name: string, tint: color, set: bool }
export struct FlagData { x: float, label: string, tint: color }

export struct DeckData {
    letter: string, tint: color, tint2: color, title: string, artist: string, initials: string, sleeve: color,
    bpm: string, pitch: string, key: string, left: string, gone: string, state: string,
    playing: bool, synced: bool, master: bool, keylock: bool,
    gain: float, hi: float, mid: float, low: float, filter: float, fader: float, level: float, pitch-pos: float,
    pads1: [PadData], pads2: [PadData],
    wave: image, flags: [FlagData],
    overview: image, played: float, cues: string, remain: string,
}

export struct RowData {
    i: string, title: string, artist: string, bpm: string, key: string, time: string, fits: int,
    initials: string, sleeve: color, deck: string, deck-tint: color, ink: color, on-deck: bool,
}

export struct NextData { title: string, artist: string, meta: string, initials: string, sleeve: color }

component Label inherits Text {
    font-family: "Archivo Label";
    font-size: 11px;
    letter-spacing: 1px;
    color: Theme.faint-on-glass;
    vertical-alignment: center;
}

component Mono inherits Text {
    font-family: "JetBrains Mono";
    vertical-alignment: center;
}

component Panel inherits Rectangle {
    in property <bool> dense;
    background: dense ? Theme.glass-dense : Theme.glass-panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.glass-edge;
    Rectangle {
        x: 10px;
        y: 1px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.glass-highlight;
    }
}

// lit: 0 none, 1 deck A, 2 deck B, 3 in step
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> lit;
    in property <length> size: 11.5px;
    callback clicked();
    property <color> tint: lit == 1 ? Theme.deck-a : lit == 2 ? Theme.deck-b : Theme.ok;
    border-radius: 6px;
    border-width: 1px;
    background: lit == 0 ? (ta.has-hover ? #ffffff17 : #ffffff0d) : tint.with-alpha(ta.has-hover ? 0.24 : 0.15);
    border-color: lit == 0 ? #ffffff1c : tint.with-alpha(0.6);
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-family: "Archivo Label";
        font-size: root.size;
        letter-spacing: 1px;
        color: lit == 1 ? Theme.deck-a-tint : lit == 2 ? Theme.deck-b-tint : lit == 3 ? #cff5df : Theme.soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Knob inherits Rectangle {
    in property <float> value;
    in property <bool> bipolar;
    in property <color> tint;
    in property <string> label;
    callback changed(float);
    property <float> start;
    property <angle> at: 135deg + 270deg * value;
    property <angle> a0: bipolar ? min(270deg, at) : 135deg;
    property <angle> a1: bipolar ? max(270deg, at) : at;
    width: 40px;
    height: 54px;
    Path {
        y: 0;
        width: 40px;
        height: 40px;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: Theme.edge;
        stroke-width: 2.7px;
        MoveTo { x: 20 + 13.5 * cos(135deg); y: 20 + 13.5 * sin(135deg); }
        ArcTo { x: 20 + 13.5 * cos(45deg); y: 20 + 13.5 * sin(45deg); radius-x: 13.5; radius-y: 13.5; large-arc: true; sweep: true; }
    }
    if a1 - a0 > 0.5deg: Path {
        y: 0;
        width: 40px;
        height: 40px;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: root.tint;
        stroke-width: 2.7px;
        MoveTo { x: 20 + 13.5 * cos(a0); y: 20 + 13.5 * sin(a0); }
        ArcTo { x: 20 + 13.5 * cos(a1); y: 20 + 13.5 * sin(a1); radius-x: 13.5; radius-y: 13.5; large-arc: a1 - a0 > 180deg; sweep: true; }
    }
    Rectangle {
        x: 10.5px;
        y: 10.5px;
        width: 19px;
        height: 19px;
        border-radius: 9.5px;
        background: #1E2027;
        border-width: 1px;
        border-color: #33363E;
    }
    Path {
        y: 0;
        width: 40px;
        height: 40px;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: Theme.text;
        stroke-width: 2px;
        MoveTo { x: 20; y: 20; }
        LineTo { x: 20 + 8 * cos(at); y: 20 + 8 * sin(at); }
    }
    Label {
        y: 38px;
        width: 40px;
        height: 14px;
        text: root.label;
        horizontal-alignment: center;
    }
    TouchArea {
        height: 40px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start = root.value;
            }
        }
        moved => {
            root.changed(clamp(root.start - (self.mouse-y - self.pressed-y) / 250px, 0, 1));
        }
    }
}

component Meter inherits Rectangle {
    in property <float> level;
    property <length> seg: (self.height - 34px) / 18;
    for i in 18: Rectangle {
        y: i * (root.seg + 2px);
        height: root.seg;
        border-radius: 1px;
        background: (18 - i) / 18 <= root.level ? (i < 2 ? Theme.hot : i < 5 ? Theme.warm : #D7DAE0) : #22252C;
    }
}

component VFader inherits Rectangle {
    in property <float> value;
    callback changed(float);
    property <float> start;
    width: 34px;
    Rectangle {
        x: 15px;
        width: 4px;
        border-radius: 2px;
        background: Theme.line;
    }
    Rectangle {
        x: 2px;
        y: (1 - root.value) * (root.height - 18px);
        width: 30px;
        height: 18px;
        border-radius: 4px;
        background: Theme.cap;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start = root.value;
            }
        }
        moved => {
            root.changed(clamp(root.start - (self.mouse-y - self.pressed-y) / (root.height - 18px), 0, 1));
        }
    }
}

component Sleeve inherits Rectangle {
    in property <string> initials;
    in property <length> size: 28px;
    width: size;
    height: size;
    border-radius: size > 40px ? 8px : 4px;
    Text {
        text: root.initials;
        font-family: "Archivo Mark";
        font-size: root.size * 0.38;
        color: #ffffffdb;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PadRow inherits HorizontalLayout {
    in property <[PadData]> pads;
    callback hit(int);
    spacing: 8px;
    height: 40px;
    for p[i] in pads: Rectangle {
        border-radius: 6px;
        border-width: 1px;
        background: p.set ? p.tint.with-alpha(pta.has-hover ? 0.26 : 0.15) : transparent;
        border-color: p.set ? p.tint.with-alpha(0.65) : #33363E;
        pta := TouchArea {
            clicked => { root.hit(i); }
        }
        HorizontalLayout {
            padding-left: 10px;
            spacing: 8px;
            alignment: start;
            Mono { text: p.n; font-size: 11px; color: p.set ? #ffffffcc : Theme.faint; }
            Label { text: p.name; font-size: 11.5px; color: Theme.text; }
        }
    }
}

component DeckPanel inherits Panel {
    in property <DeckData> d;
    callback play();
    callback sync();
    callback keylock();
    callback pad(int);
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            height: 64px;
            spacing: 14px;
            Sleeve { size: 64px; initials: d.initials; background: d.sleeve; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Mono { text: d.letter; font-size: 12px; font-weight: 600; color: d.tint; }
                    Text { text: d.title; font-size: 17px; font-weight: 600; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                }
                Text { text: d.artist; font-size: 13px; color: Theme.muted; overflow: elide; }
            }
            VerticalLayout {
                alignment: center;
                Mono { text: d.bpm; font-size: 30px; font-weight: 600; color: Theme.text; horizontal-alignment: right; }
                Mono { text: d.pitch + " · " + d.key; font-size: 12px; color: Theme.muted; horizontal-alignment: right; }
            }
            Rectangle { width: 1px; background: Theme.edge; }
            VerticalLayout {
                width: 92px;
                alignment: center;
                Mono { text: d.left; font-size: 22px; color: Theme.text; horizontal-alignment: right; }
                Mono { text: d.gone; font-size: 12px; color: Theme.faint-on-glass; horizontal-alignment: right; }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            GridLayout {
                width: 150px;
                spacing: 8px;
                Row {
                    Btn { height: 44px; text: "CUE"; }
                    Btn { height: 44px; text: d.playing ? "❚❚" : "▶"; lit: d.playing ? (d.letter == "A" ? 1 : 2) : 0; clicked => { root.play(); } }
                }
                Row {
                    Btn { height: 30px; text: "SYNC"; lit: d.synced ? 3 : 0; clicked => { root.sync(); } }
                    Btn { height: 30px; text: "MASTER"; lit: d.master ? (d.letter == "A" ? 1 : 2) : 0; }
                }
                Row {
                    Btn { height: 30px; colspan: 2; text: "KEY LOCK"; lit: d.keylock ? (d.letter == "A" ? 1 : 2) : 0; clicked => { root.keylock(); } }
                }
                Row {
                    Btn { height: 30px; text: "SLIP"; }
                    Btn { height: 30px; text: "BRAKE"; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    height: 14px;
                    Label { text: "HOT CUES"; horizontal-stretch: 1; }
                    Label { text: "AUTO PADS"; }
                }
                PadRow { pads: d.pads1; hit(i) => { root.pad(i); } }
                PadRow { pads: d.pads2; hit(i) => { root.pad(i + 4); } }
                HorizontalLayout {
                    height: 26px;
                    spacing: 2px;
                    alignment: start;
                    Label { text: "LOOP"; width: 44px; }
                    for s[i] in ["1/4", "1/2", "1", "2", "4", "8", "16", "32"]: Rectangle {
                        width: 36px;
                        border-radius: 5px;
                        background: i == 5 ? Theme.edge : transparent;
                        Mono { text: s; font-size: 11.5px; color: i == 5 ? Theme.text : Theme.muted; horizontal-alignment: center; }
                    }
                }
            }
            VerticalLayout {
                width: 46px;
                spacing: 6px;
                Label { text: "±8"; horizontal-alignment: center; height: 14px; }
                Rectangle {
                    vertical-stretch: 1;
                    Rectangle { x: 21px; width: 4px; border-radius: 2px; background: Theme.line; }
                    Rectangle { x: 8px; y: parent.height / 2; width: 30px; height: 1px; background: #4A4E57; }
                    Rectangle {
                        x: 5px;
                        y: (parent.height - 16px) * (0.5 - d.pitch-pos / 2);
                        width: 36px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.cap;
                    }
                }
                Mono { text: d.pitch; font-size: 11px; color: Theme.muted; horizontal-alignment: center; height: 14px; }
            }
        }
    }
}

component Channel inherits HorizontalLayout {
    in property <DeckData> d;
    in property <int> idx;
    callback knob(int, float);
    callback fader(float);
    spacing: 12px;
    VerticalLayout {
        spacing: 0px;
        Knob { label: "GAIN"; value: d.gain; tint: #9DA1AA; changed(v) => { root.knob(0, v); } }
        Knob { label: "HIGH"; value: d.hi; tint: d.tint; bipolar: true; changed(v) => { root.knob(1, v); } }
        Knob { label: "MID"; value: d.mid; tint: d.tint; bipolar: true; changed(v) => { root.knob(2, v); } }
        Knob { label: "LOW"; value: d.low; tint: d.tint; bipolar: true; changed(v) => { root.knob(3, v); } }
        Knob { label: "FILTER"; value: d.filter; tint: #9DA1AA; bipolar: true; changed(v) => { root.knob(4, v); } }
    }
    VerticalLayout {
        spacing: 8px;
        Mono { text: d.letter; font-size: 12px; font-weight: 600; color: d.tint; horizontal-alignment: center; height: 16px; }
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            Meter { width: 6px; level: d.level; }
            VFader { value: d.fader; changed(v) => { root.fader(v); } }
        }
        Btn { height: 24px; text: "ECHO"; size: 11px; }
    }
}

export component AppWindow inherits Window {
    title: "WetOwl Desk — Slint";
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: Theme.ground;

    in property <image> backdrop;
    in property <image> ball;
    in property <DeckData> deck-a;
    in property <DeckData> deck-b;
    in property <string> master-bpm;
    in property <string> master-name;
    in property <color> master-tint;
    in property <string> set-time;
    in property <bool> auto;
    in property <float> load;
    in property <string> load-text;
    in property <float> crossfader;
    in property <bool> phase-on;
    in property <string> phase-text;
    in property <float> phase-pos;
    in property <bool> mixing;
    in property <color> mix-from;
    in property <color> mix-to;
    in property <string> mix-from-letter;
    in property <string> mix-to-letter;
    in property <string> mix-status;
    in property <float> mix-progress;
    in property <[RowData]> rows;
    in property <[NextData]> next;
    in-out property <string> search;
    out property <length> wave-width: self.width - 26px;

    callback play(int);
    callback sync(int);
    callback keylock(int);
    callback pad(int, int);
    callback knob(int, int, float);
    callback fader(int, float);
    callback crossfade(float);
    callback toggle-auto();
    callback load-row(int);
    callback search-edited(string);

    property <length> page: 12px;
    property <length> deck-w: (self.width - 24px - 440px - 20px) / 2;
    property <length> rest-y: 12px + 48px + 10px + 66px + 10px + 252px + 10px + 318px + 10px;

    Image {
        width: 100%;
        height: 100%;
        source: root.backdrop;
        image-fit: fill;
    }

    // top bar
    Panel {
        x: page;
        y: 12px;
        width: root.width - 24px;
        height: 48px;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 18px;
            Rectangle {
                y: 7px;
                width: 104px;
                height: 34px;
                border-radius: 6px;
                background: Theme.red;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 1px;
                    alignment: start;
                    Text { text: "WET"; font-family: "Archivo Mark"; font-size: 27px; color: white; vertical-alignment: center; }
                    Image { source: root.ball; width: 22px; height: 22px; y: 6px; }
                    Text { text: "WL"; font-family: "Archivo Mark"; font-size: 27px; color: white; vertical-alignment: center; }
                }
            }
            for t[i] in ["BOOTH", "SHOW", "CRATE", "POOL"]: Rectangle {
                width: 64px;
                Label { text: t; font-size: 13px; color: i == 0 ? Theme.text : #8D919B; horizontal-alignment: center; }
                if i == 0: Rectangle { y: parent.height - 2px; height: 2px; background: Theme.red; }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Label { text: "MASTER"; }
                Mono { text: root.master-bpm; font-size: 22px; font-weight: 600; color: Theme.text; }
                Label { text: root.master-name; color: root.master-tint; }
                Rectangle { width: 30px; }
                Label { text: "SET"; }
                Mono { text: root.set-time; font-size: 15px; color: Theme.soft; }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                y: 9px;
                width: 96px;
                height: 30px;
                text: "   AUTO DJ";
                lit: root.auto ? 3 : 0;
                clicked => { root.toggle-auto(); }
                Rectangle { x: 10px; y: 11.5px; width: 7px; height: 7px; border-radius: 3.5px; background: root.auto ? Theme.ok : Theme.faint; }
            }
            Btn {
                y: 9px;
                width: 66px;
                height: 30px;
                text: "   REC";
                Rectangle { x: 10px; y: 11px; width: 8px; height: 8px; border-radius: 4px; border-width: 1.5px; border-color: Theme.red; }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "DSP"; }
                Rectangle {
                    y: 21px;
                    width: 64px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.line;
                    Rectangle { x: 0; width: 64px * min(root.load, 1); border-radius: 3px; background: #9DA1AA; }
                }
                Mono { text: root.load-text; font-size: 12px; color: Theme.muted; }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { y: 20.5px; width: 7px; height: 7px; border-radius: 3.5px; background: Theme.ok; }
                Label { text: "HOUSE"; color: Theme.muted; }
            }
            Btn { y: 9px; width: 34px; height: 30px; text: "⚙"; }
        }
    }

    // overviews
    Panel {
        x: page;
        y: 70px;
        width: root.width - 24px;
        height: 66px;
        dense: true;
        for d[i] in [root.deck-a, root.deck-b]: Rectangle {
            y: 8px + i * 28px;
            height: 22px;
            Mono { x: 12px; width: 14px; text: d.letter; font-size: 12px; font-weight: 600; color: d.tint; }
            Rectangle {
                x: 36px;
                width: parent.width - 36px - 86px;
                Image { width: 100%; height: 100%; source: d.overview; image-fit: fill; }
                Rectangle { x: 0; width: parent.width * d.played; background: #0A0B0D8c; }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: self.width / 1px;
                    viewbox-height: 22;
                    commands: d.cues;
                    stroke: #ECEDEFb3;
                    stroke-width: 2px;
                }
                Rectangle { x: parent.width * d.played; width: 3px; background: white; }
            }
            Mono { x: parent.width - 76px; width: 64px; text: d.remain; font-size: 12px; color: Theme.muted; horizontal-alignment: right; }
        }
    }

    // waveforms
    Panel {
        x: page;
        y: 146px;
        width: root.width - 24px;
        height: 252px;
        dense: true;
        clip: true;
        for d[i] in [root.deck-a, root.deck-b]: Rectangle {
            x: 1px;
            y: 8px + i * 116px;
            width: parent.width - 2px;
            height: 112px;
            Image { width: 100%; height: 100%; source: d.wave; image-fit: fill; }
            for f in d.flags: Rectangle {
                x: f.x * 1px;
                width: 120px;
                Rectangle { x: 0; width: 2px; background: f.tint; }
                Path {
                    x: 0;
                    y: 0;
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    fill: f.tint;
                    MoveTo { x: 0; y: 0; }
                    LineTo { x: 12; y: 0; }
                    LineTo { x: 0; y: 12; }
                    Close { }
                }
                Label { x: 16px; y: 6px; height: 12px; text: f.label; color: f.tint; }
            }
            Rectangle { x: parent.width / 2 - 1px; width: 2px; background: white; }
            HorizontalLayout {
                x: 12px;
                y: 8px;
                width: 300px;
                height: 14px;
                spacing: 8px;
                alignment: start;
                Mono { text: d.letter; font-size: 12px; font-weight: 600; color: d.tint; }
                Label { text: d.state; color: Theme.soft; }
            }
        }
        if root.phase-on: Rectangle {
            x: parent.width / 2 - 125px;
            y: 113px;
            width: 250px;
            height: 18px;
            border-radius: 9px;
            background: #0A0B0Dd9;
            Label { x: 10px; text: "PHASE"; }
            Rectangle { x: 65px; y: 7px; width: 120px; height: 4px; border-radius: 2px; background: Theme.edge; }
            Rectangle { x: 123px + root.phase-pos * 58px; y: 4px; width: 4px; height: 10px; border-radius: 2px; background: Theme.ok; }
            Mono { x: parent.width - 70px; width: 60px; text: root.phase-text; font-size: 11px; color: #CFF5DF; horizontal-alignment: right; }
        }
    }

    // decks + mixer
    DeckPanel {
        x: page;
        y: 408px;
        width: root.deck-w;
        height: 318px;
        d: root.deck-a;
        play => { root.play(0); }
        sync => { root.sync(0); }
        keylock => { root.keylock(0); }
        pad(i) => { root.pad(0, i); }
    }
    DeckPanel {
        x: root.width - page - root.deck-w;
        y: 408px;
        width: root.deck-w;
        height: 318px;
        d: root.deck-b;
        play => { root.play(1); }
        sync => { root.sync(1); }
        keylock => { root.keylock(1); }
        pad(i) => { root.pad(1, i); }
    }
    Panel {
        x: page + root.deck-w + 10px;
        y: 408px;
        width: 440px;
        height: 318px;
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            HorizontalLayout {
                vertical-stretch: 1;
                Channel { d: root.deck-a; idx: 0; knob(k, v) => { root.knob(0, k, v); } fader(v) => { root.fader(0, v); } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    spacing: 8px;
                    Label { text: "MASTER"; horizontal-alignment: center; height: 16px; }
                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;
                        Meter { width: 7px; level: max(root.deck-a.level, root.deck-b.level); }
                        Meter { width: 7px; level: max(root.deck-a.level, root.deck-b.level) * 0.97; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Channel { d: root.deck-b; idx: 1; knob(k, v) => { root.knob(1, k, v); } fader(v) => { root.fader(1, v); } }
            }
            Rectangle {
                height: 30px;
                Mono { x: 0; width: 12px; text: "A"; font-size: 12px; color: Theme.deck-a; }
                Mono { x: parent.width - 12px; width: 12px; text: "B"; font-size: 12px; color: Theme.deck-b; }
                Rectangle { x: 24px; y: 13px; width: parent.width - 48px; height: 4px; border-radius: 2px; background: Theme.line; }
                Rectangle { x: parent.width / 2; y: 4px; width: 1px; height: 22px; background: #4A4E57; }
                Rectangle {
                    x: 24px + root.crossfader * (parent.width - 48px - 28px);
                    y: 4px;
                    width: 28px;
                    height: 22px;
                    border-radius: 4px;
                    background: Theme.cap;
                }
                property <float> start;
                TouchArea {
                    x: 24px;
                    width: parent.width - 48px;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            parent.start = root.crossfader;
                        }
                    }
                    moved => {
                        root.crossfade(clamp(parent.start + (self.mouse-x - self.pressed-x) / (self.width - 28px), 0, 1));
                    }
                }
            }
        }
    }

    // crate
    Panel {
        x: page;
        y: rest-y;
        width: root.width - 24px - 410px;
        height: root.height - rest-y - 12px;
        dense: true;
        clip: true;
        Rectangle {
            x: 0;
            width: 230px;
            VerticalLayout {
                padding: 10px;
                padding-top: 14px;
                spacing: 2px;
                alignment: start;
                Label { text: "LIBRARY"; height: 20px; x: 8px; }
                for t[i] in [
                    { name: "All records", n: "27,457" }, { name: "Liked Songs", n: "13,820" }, { name: "Fetched here", n: "40" },
                    { name: "", n: "" }, { name: "Techno · Hard & Rave", n: "47" }, { name: "Techno · Now (2025–26)", n: "43" },
                    { name: "Techno · Peak-Time Main Room", n: "40" }, { name: "Techno · Berlin Hypnotic", n: "39" }, { name: "80s", n: "50" },
                    { name: "vvv favs", n: "229" },
                ]: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: i == 2 ? #ffffff12 : transparent;
                    if t.name == "": Label { x: 8px; text: "CRATES"; }
                    if t.name != "": HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { text: t.name; font-size: 13px; color: i == 2 ? Theme.text : #B9BCC4; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Mono { text: t.n; font-size: 11px; color: Theme.faint; }
                    }
                }
            }
        }
        Rectangle { x: 230px; width: 1px; background: #ffffff0f; }
        Rectangle {
            x: 231px;
            width: parent.width - 231px;
            Rectangle {
                x: 14px;
                y: 8px;
                width: 360px;
                height: 32px;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.edge;
                background: #ffffff08;
                Rectangle { x: 10px; y: 9px; width: 11px; height: 11px; border-radius: 5.5px; border-width: 1.8px; border-color: Theme.faint; }
                input := TextInput {
                    x: 32px;
                    width: parent.width - 40px;
                    text <=> root.search;
                    single-line: true;
                    font-size: 13px;
                    color: Theme.text;
                    vertical-alignment: center;
                    edited => { root.search-edited(self.text); }
                }
                if root.search == "": Text {
                    x: 32px;
                    text: "Search everything — library, YouTube, Bandcamp";
                    font-size: 13px;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                x: parent.width - 14px - 220px;
                y: 10px;
                width: 220px;
                height: 28px;
                spacing: 8px;
                Btn { text: "FITS"; }
                Btn { text: "BPM"; }
                Btn { text: "KEY"; }
            }
            HorizontalLayout {
                y: 46px;
                height: 26px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Label { text: "#"; width: 28px; }
                Rectangle { width: 34px; }
                Label { text: "TITLE"; horizontal-stretch: 6; }
                Label { text: "ARTIST"; horizontal-stretch: 4; }
                Label { text: "BPM"; width: 64px; horizontal-alignment: right; }
                Label { text: "KEY"; width: 48px; }
                Label { text: "TIME"; width: 56px; horizontal-alignment: right; }
                Label { text: "FITS"; width: 120px; }
            }
            Rectangle { y: 72px; height: 1px; background: #ffffff14; }
            ListView {
                y: 73px;
                height: parent.height - 73px;
                for r[i] in root.rows: Rectangle {
                    height: 34px;
                    background: rta.has-hover ? #ffffff0d : transparent;
                    rta := TouchArea {
                        double-clicked => { root.load-row(i); }
                    }
                    Rectangle { y: 33px; height: 1px; background: #ffffff0a; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Mono { text: r.i; width: 28px; font-size: 11px; color: Theme.faint; }
                        Sleeve { y: 3px; initials: r.initials; background: r.sleeve; }
                        Rectangle { width: 6px; }
                        HorizontalLayout {
                            horizontal-stretch: 6;
                            spacing: 8px;
                            if r.on-deck: Rectangle {
                                y: 8px;
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: r.deck-tint;
                                Mono { text: r.deck; font-size: 10px; font-weight: 600; color: Theme.ground; horizontal-alignment: center; }
                            }
                            Text { text: r.title; font-size: 13px; color: r.ink; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        Text { text: r.artist; horizontal-stretch: 4; font-size: 13px; color: Theme.muted; overflow: elide; vertical-alignment: center; }
                        Mono { text: r.bpm; width: 64px; font-size: 12px; color: Theme.text; horizontal-alignment: right; }
                        Mono { text: r.key; width: 48px; font-size: 12px; color: Theme.muted; }
                        Mono { text: r.time; width: 56px; font-size: 12px; color: Theme.muted; horizontal-alignment: right; }
                        HorizontalLayout {
                            width: 120px;
                            spacing: 8px;
                            if !r.on-deck: Rectangle {
                                y: 15px;
                                width: 70px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.line;
                                Rectangle { x: 0; width: 0.7px * r.fits; border-radius: 2px; background: #9DA1AA; }
                            }
                            if !r.on-deck: Mono { text: r.fits; font-size: 11px; color: Theme.muted; }
                        }
                    }
                }
            }
        }
    }

    // auto dj
    Panel {
        x: root.width - page - 400px;
        y: rest-y;
        width: 400px;
        height: root.height - rest-y - 12px;
        clip: true;
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                height: 14px;
                Label { text: "AUTO DJ"; color: Theme.soft; horizontal-stretch: 1; }
                Label { text: root.auto ? "ON · FOLLOWS YOUR HANDS" : "OFF"; color: root.auto ? Theme.ok : Theme.faint-on-glass; }
            }
            Rectangle {
                height: 132px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #ffffff0f;
                background: #ffffff09;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        height: 16px;
                        spacing: 8px;
                        Mono { text: root.mix-from-letter; font-size: 12px; color: root.mix-from; }
                        Text { text: "→"; font-size: 13px; color: Theme.muted; vertical-alignment: center; }
                        Mono { text: root.mix-to-letter; font-size: 12px; color: root.mix-to; }
                        Text { text: "Long blend"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                        Mono { text: root.mix-status; font-size: 12px; color: Theme.muted; }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.line;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.mix-progress;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, root.mix-from 0%, root.mix-to 100%);
                        }
                        Rectangle { x: parent.width / 2; y: -3px; width: 2px; height: 12px; background: Theme.text; }
                    }
                    Text { text: "Bass swap on bar 17"; font-size: 12px; color: Theme.muted; height: 14px; }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Btn { text: "MIX NOW"; }
                        Btn { text: "NOT THAT"; }
                        Btn { text: "HOLD"; clicked => { root.toggle-auto(); } }
                    }
                }
            }
            Label { text: "UP NEXT"; height: 14px; }
            for n in root.next: HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Sleeve { size: 36px; y: 2px; initials: n.initials; background: n.sleeve; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: n.title; font-size: 13px; color: Theme.text; overflow: elide; }
                    Text { text: n.artist; font-size: 12px; color: Theme.muted; overflow: elide; }
                }
                Mono { text: n.meta; font-size: 11px; color: Theme.muted; }
            }
        }
    }
}
