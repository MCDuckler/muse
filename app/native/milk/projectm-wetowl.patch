+void projectm_set_custom_variable(projectm_handle instance, const char* name, float value)
+{
+    (void) instance;
+    libprojectM::MilkdropPreset::WetOwlVariables::Set(name, value);
+}
+
+void projectm_set_audio_levels(projectm_handle instance, float bass, float mid, float treb,
+                               float bass_att, float mid_att, float treb_att)
+{
+    (void) instance;
+    auto& v = libprojectM::MilkdropPreset::WetOwlVariables::levels;
+    v[0] = bass;
+    v[1] = mid;
+    v[2] = treb;
+    v[3] = bass_att;
+    v[4] = mid_att;
+    v[5] = treb_att;
+    libprojectM::MilkdropPreset::WetOwlVariables::levelsSet = true;
+}
+
+void projectm_clear_audio_levels(projectm_handle instance)
+{
+    (void) instance;
+    libprojectM::MilkdropPreset::WetOwlVariables::levelsSet = false;
+}
+
+void projectm_opengl_set_target_framebuffer(projectm_handle instance, unsigned int framebuffer)
+{
+    (void) instance;
+    libprojectM::MilkdropPreset::WetOwlVariables::targetFramebuffer = framebuffer;
+}
+
 void projectm_set_beat_sensitivity(projectm_handle instance, float sensitivity)
 {
     auto projectMInstance = handle_to_instance(instance);
