diff --git a/src/libprojectM/MilkdropPreset/WetOwlVariables.hpp b/src/libprojectM/MilkdropPreset/WetOwlVariables.hpp
new file mode 100644
index 0000000..11f62bf
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/WetOwlVariables.hpp
@@ -0,0 +1,48 @@
+#pragma once
+
+/**
+ * @file WetOwlVariables.hpp
+ * @brief Values the host sets by name, read in preset code like bass or time.
+ *
+ * WetOwl's patch. A preset's equations can read wo_* (whatever the host set through
+ * projectm_set_custom_variable) in per-frame, per-vertex, shape and waveform code.
+ * Names are registered in a code context when its preset loads; a name set after
+ * that is read by the next preset.
+ */
+
+#include <string>
+#include <vector>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+struct WetOwlVariables
+{
+    static inline std::vector<std::string> names;
+    static inline std::vector<float> values;
+
+    /// The host's own bass/mid/treb (with their slow followers) in place of the
+    /// FFT's, while set: a beat grid, not a guess at one. Negative = not set.
+    static inline float levels[6] = {-1, -1, -1, -1, -1, -1};
+    static inline bool levelsSet = false;
+
+    /// The framebuffer the final frame is drawn into: 0 is the window's.
+    static inline unsigned int targetFramebuffer = 0;
+
+    static void Set(const char* name, float value)
+    {
+        for (size_t i = 0; i < names.size(); i++)
+        {
+            if (names[i] == name)
+            {
+                values[i] = value;
+                return;
+            }
+        }
+        names.emplace_back(name);
+        values.push_back(value);
+    }
+};
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/WetOwlVariablesEval.hpp b/src/libprojectM/MilkdropPreset/WetOwlVariablesEval.hpp
new file mode 100644
index 0000000..b708d59
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/WetOwlVariablesEval.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+/**
+ * @file WetOwlVariablesEval.hpp
+ * @brief The host's wo_* values, registered in and loaded into a code context.
+ */
+
+#include "WetOwlVariables.hpp"
+
+#include <projectm-eval.h>
+
+#include <vector>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+inline void WetOwlRegister(projectm_eval_context* ctx, std::vector<PRJM_EVAL_F*>& slots)
+{
+    slots.clear();
+    for (const auto& name : WetOwlVariables::names)
+    {
+        slots.push_back(projectm_eval_context_register_variable(ctx, name.c_str()));
+    }
+}
+
+inline void WetOwlLoad(const std::vector<PRJM_EVAL_F*>& slots)
+{
+    for (size_t i = 0; i < slots.size() && i < WetOwlVariables::values.size(); i++)
+    {
+        *slots[i] = static_cast<PRJM_EVAL_F>(WetOwlVariables::values[i]);
+    }
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
