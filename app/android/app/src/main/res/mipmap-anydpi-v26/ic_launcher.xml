<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon in layers, so the launcher can shape it without adding a white
     disc of its own. Written for by deploy/bake_icon.py, which makes the three pictures
     and the background colour from whatever icon the server is serving. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
